{
    "name": "niangpro/framework",
    "description": "Un micro-framework PHP ultra simple, plus simple que Laravel : routeur, DI, ORM minimal, auth, tests, sans dépendance à l'exécution.",
    "type": "project",
    "keywords": ["framework", "micro-framework", "php", "router", "orm", "minimal"],
    "license": "MIT",
    "authors": [
        {
            "name": "NiangProgrammeur"
        }
    ],
    "homepage": "https://github.com/NiangPro/niangpro",
    "support": {
        "issues": "https://github.com/NiangPro/niangpro/issues",
        "source": "https://github.com/NiangPro/niangpro"
    },
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Niang\\": "src/",
            "App\\": "app/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse"
    }
}
