APP_NAME=NiangPro
APP_DEBUG=true
APP_URL=http://localhost:8000
# Langue des messages vus par les visiteurs : fr (défaut) ou en — voir lang/.
APP_LOCALE=fr
APP_KEY=

DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite

# Pour MySQL/PostgreSQL, décommentez et adaptez :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=niangpro
# DB_USERNAME=root
# DB_PASSWORD=

# Pour séparer lecture et écriture (réplicas), décommentez et adaptez :
# DB_READ_HOST=replica.example.com
# DB_READ_DATABASE=niangpro

# Plusieurs serveurs web derrière un répartiteur de charge : sessions, cache et limitation de débit
# en base (file par défaut), puis ./bin/niang migrate — voir README.
# SESSION_DRIVER=database
# CACHE_DRIVER=database
# QUEUE_DRIVER=database
# Ou Redis pour les trois (CACHE_DRIVER=redis, SESSION_DRIVER=redis, QUEUE_DRIVER=redis) :
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_PREFIX=monapp:

# Session (voir config/session.php) — valeurs par défaut raisonnables, à ajuster si besoin :
# SESSION_LIFETIME=120
# SESSION_SAME_SITE=Lax
# SESSION_SECURE_COOKIE=true

# Journaux (storage/logs, un fichier par jour) : niveau minimal écrit, et jours conservés (0 = tous).
# LOG_CHANNEL=daily
# LOG_FORMAT=line
# LOG_LEVEL=debug
# LOG_DAYS=14

# Métriques Prometheus sur GET /metrics (Authorization: Bearer <METRICS_TOKEN>) :
# METRICS_ENABLED=true
# METRICS_TOKEN=

# Connexion avec Google ou GitHub (voir README, section Authentification) : URL de retour à déclarer
# chez le fournisseur = APP_URL/auth/google/callback (ou github).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Fichiers (Storage) : local (storage/app, défaut) ou s3 (AWS S3, Cloudflare R2, MinIO, Wasabi...).
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-3
# AWS_BUCKET=
# Service compatible S3 : son adresse (sinon AWS). URL publique (CDN) facultative.
# AWS_ENDPOINT=
# AWS_URL=

# Emails (voir README, section Emails) : log (défaut, écrit dans storage/logs), array (tests) ou smtp.
# Pas de commentaire en fin de ligne dans ce fichier : il ferait partie de la valeur.
MAIL_MAILER=log
# Pour un envoi réel, passez MAIL_MAILER=smtp et renseignez :
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=contact@example.com
# Sans MAIL_FROM_NAME, APP_NAME est utilisé comme nom d'expéditeur.
# MAIL_FROM_NAME=NiangPro
