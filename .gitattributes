# Fins de ligne forcées en LF pour tout le texte : sans ça, un checkout Windows avec
# core.autocrlf=true convertit bin/niang en CRLF, et son shebang (#!/usr/bin/env php)
# échoue sous WSL/Git Bash ("env: 'php\r': No such file or directory") — bug réel, pas
# théorique. `text=auto` détecte les fichiers binaires (images, etc.) et les laisse intacts.
* text=auto eol=lf

# Scripts shell : jamais de CRLF, exécutables préservés quel que soit git config core.fileMode.
bin/niang text eol=lf
*.sh text eol=lf

# À l'inverse : cmd.exe attend des fins de ligne CRLF pour un .bat, même si eol=lf ci-dessus
# ne s'appliquerait de toute façon qu'au checkout sur une machine Unix — explicite plutôt
# qu'implicite.
*.bat text eol=crlf

# Archive du paquet niangpro/framework (Packagist, composer install) : le framework seul — packages/,
# composer.json et les documents de référence. L'application de démonstration, ses tests et les outils
# de développement du framework restent dans le dépôt ; une application les reçoit par le squelette
# niangpro/niangpro (tools/build-skeleton.php).
/.github export-ignore
/app export-ignore
/benchmarks export-ignore
/bin export-ignore
/config export-ignore
/database export-ignore
/docker export-ignore
/docs export-ignore
/lang export-ignore
/public export-ignore
/resources export-ignore
/routes export-ignore
/skeleton export-ignore
/storage export-ignore
/tests export-ignore
/tools export-ignore
/.dockerignore export-ignore
/.env.example export-ignore
/.env.testing export-ignore
/.php-cs-fixer.php export-ignore
/compose.yaml export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
/preload.php export-ignore
/CONTRIBUTING.md export-ignore
