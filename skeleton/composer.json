{
    "name": "niangpro/niangpro",
    "description": "Squelette d'application NiangPro : composer create-project niangpro/niangpro mon-app",
    "type": "project",
    "keywords": ["niangpro", "framework", "skeleton"],
    "license": "MIT",
    "homepage": "https://github.com/NiangPro/niangpro",
    "require": {
        "php": ">=8.1",
        "niangpro/framework": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "post-create-project-cmd": "Niang\\Core\\Console\\ComposerHooks::postCreateProject"
    }
}
