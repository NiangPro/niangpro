parameters:
    level: 6
    paths:
        - src
        - app
        - tests
        - resources/scaffold
    excludePaths:
        - src/helpers.php
        # Dans resources/scaffold, seules les classes PHP des thèmes (contrôleurs, modèles, tests) sont
        # analysées : les vues, routes, configs et migrations sont des fichiers de gabarit, comme
        # resources/views/, routes/ et config/ à la racine, qui ne le sont pas non plus.
        - resources/scaffold/*/views/*
        - resources/scaffold/*/*/resources/*
        - resources/scaffold/*/*/routes/*
        - resources/scaffold/*/*/config/*
        - resources/scaffold/*/*/database/*
        - resources/scaffold/*/*/public/*
    ignoreErrors:
        # NiangPro utilise volontairement des tableaux associatifs bruts (lignes de BDD, données de
        # requête) plutôt que des objets/DTO typés, pour rester simple. Documenter chaque forme de
        # tableau en PHPDoc générique irait à l'encontre de ce choix.
        - identifier: missingType.iterableValue

        # Request::capture()/create() utilisent new static() pour que FormRequest (qui hérite du
        # constructeur sans le redéclarer) reste correctement typée à l'usage — c'est voulu ici.
        - identifier: new.static
          path: src/Core/Http/Request.php
